{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/d/:id/:action", "destination": "/d" },
    { "source": "/d/:id", "destination": "/d" },
    { "source": "/d/:path*", "destination": "/d" },
    { "source": "/dates/:id/:action", "destination": "/d" },
    { "source": "/dates/:id", "destination": "/d" },
    { "source": "/dates/:path*", "destination": "/d" },
    { "source": "/p/:id", "destination": "/d" },
    { "source": "/p/:path*", "destination": "/d" },
    { "source": "/polls/:id", "destination": "/d" },
    { "source": "/polls/:path*", "destination": "/d" },
    { "source": "/privacy", "destination": "/privacidad" },
    { "source": "/privacy/", "destination": "/privacidad" },
    { "source": "/delete-account", "destination": "/eliminar-cuenta" },
    { "source": "/delete-account/", "destination": "/eliminar-cuenta" },
    { "source": "/child-safety", "destination": "/seguridad-infantil" },
    { "source": "/child-safety/", "destination": "/seguridad-infantil" },
    { "source": "/estandares-seguridad-infantil", "destination": "/seguridad-infantil" },
    { "source": "/estandares-seguridad-infantil/", "destination": "/seguridad-infantil" }
  ]
}
