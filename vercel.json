{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/.well-known/apple-app-site-association",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    },
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/json"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/d/:path*", "destination": "/d/index.html" },
    { "source": "/dates/:path*", "destination": "/d/index.html" },
    { "source": "/p/:path*", "destination": "/d/index.html" },
    { "source": "/polls/:path*", "destination": "/d/index.html" },
    { "source": "/privacy", "destination": "/privacidad/index.html" },
    { "source": "/privacy/", "destination": "/privacidad/index.html" },
    { "source": "/privacidad", "destination": "/privacidad/index.html" },
    { "source": "/privacidad/", "destination": "/privacidad/index.html" },
    { "source": "/pages/privacidad", "destination": "/privacidad/index.html" },
    { "source": "/pages/privacidad/", "destination": "/privacidad/index.html" },
    { "source": "/delete-account", "destination": "/eliminar-cuenta/index.html" },
    { "source": "/delete-account/", "destination": "/eliminar-cuenta/index.html" },
    { "source": "/eliminar-cuenta", "destination": "/eliminar-cuenta/index.html" },
    { "source": "/eliminar-cuenta/", "destination": "/eliminar-cuenta/index.html" },
    { "source": "/pages/eliminar-cuenta", "destination": "/eliminar-cuenta/index.html" },
    { "source": "/pages/eliminar-cuenta/", "destination": "/eliminar-cuenta/index.html" },
    { "source": "/child-safety", "destination": "/seguridad-infantil/index.html" },
    { "source": "/child-safety/", "destination": "/seguridad-infantil/index.html" },
    { "source": "/seguridad-infantil", "destination": "/seguridad-infantil/index.html" },
    { "source": "/seguridad-infantil/", "destination": "/seguridad-infantil/index.html" },
    { "source": "/estandares-seguridad-infantil", "destination": "/seguridad-infantil/index.html" },
    { "source": "/estandares-seguridad-infantil/", "destination": "/seguridad-infantil/index.html" },
    { "source": "/pages/seguridad-infantil", "destination": "/seguridad-infantil/index.html" },
    { "source": "/pages/seguridad-infantil/", "destination": "/seguridad-infantil/index.html" }
  ]
}
